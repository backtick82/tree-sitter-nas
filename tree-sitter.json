{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "nas",
      "camelcase": "nas",
      "title": "Not Awesome Script",
      "scope": "source.nas",
      "file-types": [
        "nas"
      ],
      "injection-regex": "^nas$",
      "class-name": "TreeSitterNas"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Nas grammar for tree-sitter",
    "authors": [
      {
        "name": "backtick82",
        "url": "https://github.com/backtick82/"
      }
    ],
    "links": {
      "repository": "https://github.com/backtick82/tree-sitter-nas",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
