{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "nas",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "_statement"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "comment"
                      }
                    ]
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              },
              {
                "type": "SYMBOL",
                "name": "_newline"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_statement"
                },
                {
                  "type": "SYMBOL",
                  "name": "comment"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "top_level_statement"
        },
        {
          "type": "SYMBOL",
          "name": "label_definition"
        },
        {
          "type": "SYMBOL",
          "name": "conditional_statement"
        },
        {
          "type": "SYMBOL",
          "name": "action_statement"
        }
      ]
    },
    "top_level_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "using"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_word"
              },
              "named": true,
              "value": "identifier"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "include"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_path"
              },
              "named": true,
              "value": "path"
            }
          ]
        }
      ]
    },
    "label_definition": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_label_word"
          },
          "named": true,
          "value": "label_name"
        }
      ]
    },
    "conditional_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "STRING",
                  "value": "if"
                },
                {
                  "type": "STRING",
                  "value": "ifnot"
                }
              ]
            },
            {
              "type": "SYMBOL",
              "name": "condition"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_conditional_action_statement"
              },
              "named": true,
              "value": "action_statement"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "else"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_conditional_action_statement"
              },
              "named": true,
              "value": "action_statement"
            }
          ]
        }
      ]
    },
    "condition": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "item"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_conditional_word"
              },
              "named": true,
              "value": "item_name"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "label"
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "#"
                },
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_label_word"
                  },
                  "named": true,
                  "value": "label_name"
                }
              ]
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_condition_value"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "ALIAS",
                      "content": {
                        "type": "CHOICE",
                        "members": [
                          {
                            "type": "STRING",
                            "value": "|=|"
                          },
                          {
                            "type": "STRING",
                            "value": "|>|"
                          },
                          {
                            "type": "STRING",
                            "value": "|>=|"
                          },
                          {
                            "type": "STRING",
                            "value": "|<|"
                          },
                          {
                            "type": "STRING",
                            "value": "|<=|"
                          },
                          {
                            "type": "STRING",
                            "value": "|has|"
                          }
                        ]
                      },
                      "named": true,
                      "value": "operator"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "_condition_value"
                    }
                  ]
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          ]
        }
      ]
    },
    "_condition_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "true"
              },
              {
                "type": "STRING",
                "value": "false"
              }
            ]
          },
          "named": true,
          "value": "boolean"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_conditional_package_name"
          },
          "named": true,
          "value": "package_name"
        },
        {
          "type": "PATTERN",
          "value": "-?\\d+(\\.\\d+)?"
        },
        {
          "type": "PATTERN",
          "value": "\"[^\"\\n\\r]*\"",
          "flags": "u"
        },
        {
          "type": "PATTERN",
          "value": "'[^'\\n\\r]*'",
          "flags": "u"
        }
      ]
    },
    "action_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_action_word"
          },
          "named": true,
          "value": "action_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "action_arguments"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_conditional_action_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_action_word"
          },
          "named": true,
          "value": "action_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "action_arguments"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "action_arguments": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "unwrapped_package"
          },
          {
            "type": "SYMBOL",
            "name": "_line_content"
          }
        ]
      }
    },
    "unwrapped_package": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_package_name"
          },
          "named": true,
          "value": "package_name"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "_line_content": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[^ \\t\\r\\{\\n\\r]+",
          "flags": "u"
        }
      }
    },
    "_path": {
      "type": "PATTERN",
      "value": "[^ \\t\\r\\n]+",
      "flags": "u"
    },
    "_word": {
      "type": "PATTERN",
      "value": "[^ \\t\\r\\n{}]+",
      "flags": "u"
    },
    "_package_name": {
      "type": "PATTERN",
      "value": "[^\\t\\r\\n{} ]+",
      "flags": "u"
    },
    "_conditional_package_name": {
      "type": "PATTERN",
      "value": "[^\\t\\r\\n| ]+",
      "flags": "u"
    },
    "_conditional_word": {
      "type": "PATTERN",
      "value": "[^\\t\\r\\n{}|]+",
      "flags": "u"
    },
    "_action_word": {
      "type": "PATTERN",
      "value": "[a-z]+"
    },
    "_label_word": {
      "type": "PATTERN",
      "value": "[^ \\t\\r\\n|]+",
      "flags": "u"
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "//"
        },
        {
          "type": "PATTERN",
          "value": "[^\\n\\r]*",
          "flags": "u"
        }
      ]
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\n"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\r]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}